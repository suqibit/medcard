<!-- pages/home/home.wxml - 首页 -->
<view class="page">

  <!-- 复习入口卡片 -->
  <view class="card home-card" wx:if="{{stats.total > 0}}">
    <view class="stat-row">
      <view class="stat-item">
        <view class="stat-num due">{{stats.due}}</view>
        <view class="stat-label">今日到期</view>
      </view>
      <view class="stat-item">
        <view class="stat-num">{{stats.new}}</view>
        <view class="stat-label">待学习</view>
      </view>
      <view class="stat-item">
        <view class="stat-num">{{stats.pending}}</view>
        <view class="stat-label">待复习</view>
      </view>
      <view class="stat-item">
        <view class="stat-num ok-num">{{stats.doneToday}}</view>
        <view class="stat-label">今日已复习</view>
      </view>
      <view class="stat-item">
        <view class="stat-num">{{stats.streak}}</view>
        <view class="stat-label">连续打卡</view>
      </view>
      <view class="stat-item">
        <view class="stat-num">{{stats.total}}</view>
        <view class="stat-label">卡片总数</view>
      </view>
    </view>
    <view class="btn-primary {{actionDone ? 'disabled' : ''}}" hover-class="btn-primary-hover" hover-stay-time="150" bindtap="startReview">{{actionText}}</view>
  </view>

  <!-- 生成区 -->
  <view class="section-title">生成卡片</view>

  <view class="mode-switch">
    <view class="mode-btn {{mode === 'text' ? 'active' : ''}}" data-mode="text" bindtap="switchMode">学习新卡</view>
    <view class="mode-btn {{mode === 'wrong' ? 'active' : ''}}" data-mode="wrong" bindtap="switchMode">错题制卡</view>
  </view>

  <view class="card">
    <textarea
      class="input-area"
      value="{{inputText}}"
      bindinput="onInput"
      placeholder="{{placeholder}}"
      maxlength="30000"
      auto-height
    />
    <view class="input-row">
      <view class="muted">牌组名（可选）</view>
      <input class="deck-input" value="{{deckName}}" bindinput="onDeckInput" placeholder="默认牌组" />
    </view>
    <view class="input-row">
      <view class="muted">最大卡片数</view>
      <view class="opt-group">
        <view
          wx:for="{{maxCardsOptions}}"
          wx:key="*this"
          class="opt-btn {{maxCards === item ? 'active' : ''}}"
          data-v="{{item}}"
          bindtap="onMaxCards"
        >{{item}}</view>
      </view>
    </view>
    <view class="input-row">
      <view class="muted">自定义标签（逗号分隔，可选）</view>
      <view class="tag-mgmt-link" hover-class="tag-mgmt-link-hover" hover-stay-time="150" bindtap="openTagMgmt">管理</view>
      <input class="deck-input" value="{{customTags}}" bindinput="onTagsInput" placeholder="如 306,内科学" />
    </view>

    <view class="btn-secondary" hover-class="btn-secondary-hover" hover-stay-time="150" bindtap="chooseImage">
      {{ocrLoading ? '识别中…' : '📷 拍照/传图识别文字（今日剩 ' + ocrLeft + ' 次）'}}
    </view>
    <view class="btn-secondary" hover-class="btn-secondary-hover" hover-stay-time="150" bindtap="chooseFile">
      {{uploadLoading ? '解析中…' : '📄 上传 PDF / Word（今日剩 ' + uploadLeft + ' 次）'}}
    </view>

    <view class="btn-primary {{loading ? 'disabled' : ''}}" hover-class="btn-primary-hover" hover-stay-time="150" bindtap="generate">
      {{loading ? 'AI 生成中，约 10-30 秒…' : '✨ AI 生成卡片（今日剩 ' + genLeft + ' 次）'}}
    </view>

    <view class="note">内容仅用于生成记忆卡，AI 生成结果请对照原文核实（卡片均带来源引用）</view>
  </view>

  <!-- 提示条 -->
  <view class="warn" wx:if="{{errMsg}}">{{errMsg}}</view>
  <view class="ok" wx:if="{{okMsg}}">{{okMsg}}</view>

  <!-- 生成预览 -->
  <view class="card" wx:if="{{cardsPreview.length > 0}}">
    <view class="section-title">预览（{{cardsPreview.length}} 张）</view>
    <view wx:for="{{cardsPreview}}" wx:key="index" class="preview-item">
      <view class="preview-front">{{item.front}}</view>
      <view class="preview-back">{{item.back}}</view>
      <view class="preview-tags">
        <text class="tag" wx:for="{{item.tags}}" wx:for-item="tg" wx:key="*this">{{tg}}</text>
      </view>
    </view>
    <view class="btn-primary" hover-class="btn-primary-hover" hover-stay-time="150" bindtap="savePreview">保存这 {{cardsPreview.length}} 张卡片</view>
    <view class="btn-secondary" hover-class="btn-secondary-hover" hover-stay-time="150" bindtap="discardPreview">不要了</view>
  </view>

  <!-- 空状态 -->
  <view class="card" wx:if="{{stats.total === 0 && cardsPreview.length === 0}}">
    <view class="empty-text">还没有卡片</view>
    <view class="muted">粘贴教材内容或拍错题照片，让 AI 帮你生成记忆卡；生成后每天 10 分钟复习，不堆积、断了能捡回。</view>
  </view>

  <!-- 数据本地提示 -->
  <view class="note data-note">📌 卡片与复习记录仅保存在本机小程序中，清除小程序数据会全部丢失，请留意</view>

  <!-- 首次进入：隐私与数据说明弹窗 -->
  <view class="privacy-mask" wx:if="{{privacyShow}}">
    <view class="privacy-box">
      <view class="privacy-title">隐私与数据说明</view>
      <view class="privacy-item">
        <text class="privacy-strong">资料用途</text>：您粘贴的文字、上传的图片与文件仅用于生成记忆卡（文字会发送至 AI 服务进行生成），不做任何其他用途
      </view>
      <view class="privacy-item">
        <text class="privacy-strong">数据存储于本地</text>：卡组与复习记录保存在您手机的小程序本地，仅当前设备可见；清除小程序数据会导致记录丢失，请留意备份
      </view>
      <view class="privacy-item">
        <text class="privacy-strong">内容归您所有</text>：您生成的所有卡组归您本人所有，本平台不主张任何权利，亦不收集、出售或共享您的个人信息
      </view>
      <view class="privacy-note">本小程序仅提供学习工具，不提供任何医疗服务；健康相关问题请以医院及专业医生意见为准。</view>
      <view class="btn-primary" hover-class="btn-primary-hover" hover-stay-time="150" bindtap="ackPrivacy">知道了，开始使用</view>
    </view>
  </view>

  <!-- 新手引导：三步上手 -->
  <view class="modal-mask" wx:if="{{helpShow}}">
    <view class="modal-box">
      <view class="modal-title">欢迎使用医学记忆卡 🎓</view>
      <view class="modal-item"><text class="privacy-strong">第 1 步 · 生成</text>：粘贴教材文字、拍错题照片或上传 PDF/Word，AI 自动生成记忆卡（答案+解析+关联考点）</view>
      <view class="modal-item"><text class="privacy-strong">第 2 步 · 复习</text>：每天 10 分钟，到期的卡会自动出现；如实选择「忘记/困难/记得/简单」，系统安排下次复习</view>
      <view class="modal-item"><text class="privacy-strong">第 3 步 · 记录</text>：在底部「记录」页查看复习情况与薄弱点，越练越稳</view>
      <view class="modal-note">不堆积、断了能捡回——开始吧！</view>
      <view class="btn-primary" hover-class="btn-primary-hover" hover-stay-time="150" bindtap="ackHelp">知道了，开始使用</view>
    </view>
  </view>

  <!-- 自定义标签管理 -->
  <view class="modal-mask" wx:if="{{tagMgmtShow}}">
    <view class="modal-box">
      <view class="modal-title">自定义标签管理</view>
      <view class="modal-item">生成卡片时 AI 会优先匹配这些标签（最多 30 个）</view>
      <view class="tag-input-row">
        <input class="tag-input" value="{{tagNewInput}}" bindinput="onTagNewInput" placeholder="新标签，如 306" />
        <view class="tag-add-btn" hover-class="tag-add-btn-hover" hover-stay-time="150" bindtap="addTag">添加</view>
      </view>
      <view class="tag-list" wx:if="{{tagList.length > 0}}">
        <view wx:for="{{tagList}}" wx:key="*this" class="tag-mgmt-item">
          <text class="tag">{{item}}</text>
          <text class="tag-del" data-tag="{{item}}" bindtap="delTag">✕ 删除</text>
        </view>
      </view>
      <view class="modal-item muted" wx:else>还没有自定义标签</view>
      <view class="btn-primary" hover-class="btn-primary-hover" hover-stay-time="150" bindtap="closeTagMgmt">完成</view>
    </view>
  </view>

</view>
