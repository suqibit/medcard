/* pages/home/home.wxss */
.page { padding-bottom: 60rpx; }

.stat-row { display: flex; justify-content: space-around; padding: 8rpx 0 16rpx; }
.stat-item { text-align: center; }
.stat-num { font-size: 40rpx; font-weight: 600; color: #4A3F32; }
.stat-label { font-size: 22rpx; color: #8B7D6B; }

.mode-switch {
  display: flex;
  margin: 8rpx 24rpx;
  background: #EDE4D4;
  border-radius: 12rpx;
  padding: 6rpx;
}
.mode-btn {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 28rpx;
  color: #6B5B45;
  border-radius: 10rpx;
}
.mode-btn.active { background: #6B5B45; color: #F5EFE6; }

.input-area {
  width: 100%;
  min-height: 200rpx;
  background: #FFFDF8;
  border: 1rpx solid #E3D9C8;
  border-radius: 10rpx;
  padding: 16rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.input-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}
.deck-input {
  flex: 1;
  margin-left: 16rpx;
  background: #FFFDF8;
  border: 1rpx solid #E3D9C8;
  border-radius: 8rpx;
  padding: 10rpx 14rpx;
  font-size: 26rpx;
  text-align: right;
}

.opt-group { display: flex; margin-left: 16rpx; }
.opt-btn {
  background: #EDE4D4;
  color: #6B5B45;
  border-radius: 8rpx;
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  margin-left: 10rpx;
}
.opt-btn.active { background: #6B5B45; color: #F5EFE6; }

.preview-item {
  border-bottom: 1rpx dashed #E3D9C8;
  padding: 16rpx 0;
}
.preview-front { font-weight: 600; color: #4A3F32; }
.preview-back {
  font-size: 26rpx;
  color: #6B5B45;
  white-space: pre-wrap;
  margin-top: 8rpx;
}
.preview-tags { margin-top: 8rpx; }

.empty-text {
  font-size: 32rpx;
  color: #4A3F32;
  font-weight: 600;
  margin-bottom: 8rpx;
}
