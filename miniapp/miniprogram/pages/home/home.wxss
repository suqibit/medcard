/* pages/home/home.wxss */
.page { padding-bottom: 60rpx; }

.stat-row { display: flex; justify-content: space-around; padding: 8rpx 0 16rpx; }
.stat-item { text-align: center; }
.stat-num { font-size: 40rpx; font-weight: 600; color: #4A3F32; }
.stat-label { font-size: 22rpx; color: #8B7D6B; }

.mode-switch {
  display: flex;
  margin: 8rpx 24rpx;
  background: #EDE4D4;
  border-radius: 12rpx;
  padding: 6rpx;
}
.mode-btn {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 28rpx;
  color: #6B5B45;
  border-radius: 10rpx;
}
.mode-btn.active { background: #6B5B45; color: #F5EFE6; }

.input-area {
  width: 100%;
  min-height: 200rpx;
  background: #FFFDF8;
  border: 1rpx solid #E3D9C8;
  border-radius: 10rpx;
  padding: 16rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.input-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}
.deck-input {
  flex: 1;
  margin-left: 16rpx;
  background: #FFFDF8;
  border: 1rpx solid #E3D9C8;
  border-radius: 8rpx;
  padding: 10rpx 14rpx;
  font-size: 26rpx;
  text-align: right;
}

.opt-group { display: flex; margin-left: 16rpx; }
.opt-btn {
  background: #EDE4D4;
  color: #6B5B45;
  border-radius: 8rpx;
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  margin-left: 10rpx;
}
.opt-btn.active { background: #6B5B45; color: #F5EFE6; }

.preview-item {
  border-bottom: 1rpx dashed #E3D9C8;
  padding: 16rpx 0;
}
.preview-front { font-weight: 600; color: #4A3F32; }
.preview-back {
  font-size: 26rpx;
  color: #6B5B45;
  white-space: pre-wrap;
  margin-top: 8rpx;
}
.preview-tags { margin-top: 8rpx; }

.empty-text {
  font-size: 32rpx;
  color: #4A3F32;
  font-weight: 600;
  margin-bottom: 8rpx;
}

/* 首次进入隐私弹窗 */
.privacy-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(43, 38, 32, 0.55);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}
.privacy-box {
  background: #FFFDF8;
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  margin: 0 40rpx;
  max-height: 80vh;
  overflow-y: auto;
}
.privacy-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #4A3F32;
  text-align: center;
  margin-bottom: 24rpx;
}
.privacy-item {
  font-size: 26rpx;
  color: #4A3F32;
  line-height: 1.7;
  margin-bottom: 18rpx;
}
.privacy-strong { font-weight: 600; color: #2B2620; }
.privacy-note {
  font-size: 24rpx;
  color: #6B5B45;
  background: #F0E7D6;
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  margin: 8rpx 0 24rpx;
}

/* 标签管理入口 */
.tag-mgmt-link {
  color: #0E5A4A;
  font-size: 24rpx;
  margin-left: 12rpx;
  padding: 4rpx 10rpx;
  border: 1rpx solid #0E5A4A;
  border-radius: 8rpx;
}
.tag-mgmt-link:active { opacity: 0.7; }

/* 标签管理弹窗 */
.tag-input-row { display: flex; align-items: center; margin: 12rpx 0 16rpx; }
.tag-input {
  flex: 1;
  background: #FFFDF8;
  border: 1rpx solid #E3D9C8;
  border-radius: 8rpx;
  padding: 10rpx 14rpx;
  font-size: 26rpx;
}
.tag-add-btn {
  background: #6B5B45;
  color: #F5EFE6;
  border-radius: 8rpx;
  padding: 10rpx 24rpx;
  font-size: 26rpx;
  margin-left: 12rpx;
}
.tag-list { margin-bottom: 16rpx; }
.tag-mgmt-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
  border-bottom: 1rpx dashed #E3D9C8;
}
.tag-del { color: #A33B2E; font-size: 24rpx; padding: 4rpx 8rpx; }

/* 底部数据提示 */
.data-note { margin-top: 32rpx; }
