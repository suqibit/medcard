<!-- pages/records/records.wxml - 复习记录 -->
<view class="page">

  <!-- 薄弱点分析 -->
  <view class="card" wx:if="{{weakList.length > 0}}">
    <view class="section-title">薄弱点分析</view>
    <view wx:for="{{weakList}}" wx:key="tag" class="weak-row">
      <text class="weak-dot {{item.level}}"></text>
      <text class="weak-tag">{{item.tag}}</text>
      <text class="weak-rate {{item.level}}">{{item.rate}}%（{{item.correct}}/{{item.total}}）</text>
    </view>
    <view class="muted">按标签统计复习正确率，红=薄弱（&lt;60%）黄=一般 绿=稳固（≥80%）</view>
  </view>

  <!-- 标签筛选 -->
  <scroll-view scroll-x class="tag-scroll">
    <view
      wx:for="{{tagOptions}}"
      wx:key="*this"
      class="filter-tag {{activeTag === item ? 'active' : ''}}"
      data-tag="{{item}}"
      bindtap="onTag"
    >{{item}}</view>
  </scroll-view>

  <!-- 卡片列表 -->
  <view class="card" wx:if="{{cards.length === 0}}">
    <view class="muted">没有符合条件的卡片</view>
  </view>

  <view class="card rec-card" wx:for="{{cards}}" wx:key="id">
    <view class="rec-front">{{item.front}}</view>
    <view class="rec-meta muted">
      <text>轮数 {{item.rounds}}</text>
      <text> · 上次 {{item.lastText}}</text>
      <text class="{{item.dueCls}}"> · 下次 {{item.dueText}}</text>
      <text wx:if="{{item.hasQuiz}}" class="quiz-mark"> · 含选择题</text>
    </view>
    <view class="rec-tags">
      <text class="tag" wx:for="{{item.tags}}" wx:for-item="tg" wx:key="*this">{{tg}}</text>
    </view>
    <view class="btn-secondary small" data-id="{{item.id}}" bindtap="toggleAnswer">
      {{expanded[item.id] ? '收起答案' : '显示答案'}}
    </view>
    <view class="rec-back" wx:if="{{expanded[item.id]}}">
      <view class="back-text">{{item.back}}</view>
      <view class="muted" wx:if="{{item.source}}">📖 来源：{{item.source}}</view>
    </view>
  </view>

  <!-- 分页 -->
  <view class="pager" wx:if="{{totalPages > 1}}">
    <view class="page-btn {{page <= 1 ? 'disabled' : ''}}" bindtap="onPrev">上一页</view>
    <view class="muted">{{page}} / {{totalPages}}</view>
    <view class="page-btn {{page >= totalPages ? 'disabled' : ''}}" bindtap="onNext">下一页</view>
  </view>

  <!-- 复习时间说明弹窗（进入记录页时按需出现） -->
  <view class="modal-mask" wx:if="{{helpShow}}">
    <view class="modal-box">
      <view class="modal-x" bindtap="helpClose">✕</view>
      <view class="modal-title">复习时间是怎么算的？</view>
      <view class="modal-item">你每次复习后选的「忘记 / 困难 / 记得 / 简单」，系统会据此安排这张卡下次出现的时间：</view>
      <view class="modal-item">
        <text class="privacy-strong">首次学习后</text>：忘记→明天 · 困难→2 天后 · 记得→3 天后 · 简单→8 天后
      </view>
      <view class="modal-item"><text class="privacy-strong">越熟练间隔越长</text>——熟的知识不浪费你时间；<text class="privacy-strong">越生疏出现越频繁</text>——趁热打铁巩固</view>
      <view class="modal-item">只有<text class="privacy-strong">到期</text>的卡才会出现在复习页；每天有复习上限，不会堆积</view>
      <view class="modal-item">断了好几天回来也不怕：系统会提示你攒了多少，慢慢跟上，<text class="privacy-strong">不会越堆越多</text></view>
      <view class="modal-note">这一切由算法自动调度（Anki 同款），你只管如实自评。</view>
      <view class="btn-primary" bindtap="helpMonth">一月内不提醒</view>
      <view class="btn-secondary" bindtap="helpOff">永远关闭提醒</view>
    </view>
  </view>

</view>
