/* pages/records/records.wxss */
.page { padding-bottom: 60rpx; }

.weak-row { display: flex; align-items: center; padding: 10rpx 0; }
.weak-dot { width: 16rpx; height: 16rpx; border-radius: 50%; margin-right: 14rpx; }
.weak-dot.red { background: #C0392B; }
.weak-dot.yellow { background: #D68910; }
.weak-dot.green { background: #0E5A4A; }
.weak-tag { flex: 1; font-size: 26rpx; color: #4A3F32; }
.weak-rate { font-size: 26rpx; font-weight: 600; }
.weak-rate.red { color: #C0392B; }
.weak-rate.yellow { color: #D68910; }
.weak-rate.green { color: #0E5A4A; }

.tag-scroll { white-space: nowrap; padding: 8rpx 24rpx; }
.filter-tag {
  display: inline-block;
  background: #EDE4D4;
  color: #6B5B45;
  border-radius: 24rpx;
  padding: 8rpx 26rpx;
  font-size: 24rpx;
  margin-right: 14rpx;
}
.filter-tag.active { background: #6B5B45; color: #F5EFE6; }

.rec-front { font-size: 30rpx; font-weight: 600; color: #4A3F32; }
.rec-meta { margin-top: 8rpx; font-size: 22rpx; }
.quiz-mark { color: #1A5276; }
.rec-tags { margin-top: 8rpx; }

.btn-secondary.small { padding: 10rpx 0; margin: 12rpx 0 4rpx; font-size: 24rpx; }

.rec-back { margin-top: 8rpx; }
.back-text {
  font-size: 26rpx;
  white-space: pre-wrap;
  background: #F7F2E8;
  border-radius: 10rpx;
  padding: 14rpx;
  margin-bottom: 8rpx;
}

.pager { display: flex; justify-content: center; align-items: center; margin: 24rpx; }
.page-btn {
  background: #EDE4D4;
  color: #4A3F32;
  border-radius: 10rpx;
  padding: 10rpx 30rpx;
  font-size: 26rpx;
  margin: 0 30rpx;
}
.page-btn.disabled { opacity: 0.4; }

/* 弹窗关闭叉号 */
.modal-x {
  position: absolute;
  top: 16rpx;
  right: 24rpx;
  font-size: 32rpx;
  color: #8B7D6B;
  padding: 8rpx;
}
.modal-x:active { opacity: 0.6; }
