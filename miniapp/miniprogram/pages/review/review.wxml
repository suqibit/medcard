<!-- pages/review/review.wxml - 学习/复习 -->
<view class="page">

  <!-- 加载中 -->
  <view class="card" wx:if="{{loading}}">
    <view class="center-text">加载中…</view>
  </view>

  <!-- 空队列 -->
  <view class="card" wx:if="{{!loading && empty}}">
    <view class="center-text">🎉 今天没有需要复习的卡片</view>
    <view class="muted center-text">到期卡片会自动出现在这里；先回首页生成几张新卡吧</view>
    <view class="btn-primary" bindtap="goHome">回首页</view>
  </view>

  <!-- 完成 -->
  <view class="card" wx:if="{{done}}">
    <view class="center-text done-title">{{doneMsg}}</view>
    <view class="btn-primary" bindtap="restart">继续复习</view>
    <view class="btn-secondary" bindtap="goHome">回首页</view>
  </view>

  <!-- 复习中 -->
  <block wx:if="{{!loading && !empty && !done}}">
    <view class="progress muted">第 {{idx + 1}} / {{queueTotal}} 张</view>

    <!-- 模式切换：问答 / 选择题 -->
    <view class="mode-line">
      <view class="mode-pill {{!quizModePref ? 'active' : ''}}" data-m="qa" bindtap="toggleQuizMode">问答模式</view>
      <view class="mode-pill {{quizModePref ? 'active' : ''}}" data-m="quiz" bindtap="toggleQuizMode">选择题模式</view>
    </view>

    <view class="card">
      <!-- 选择题模式 -->
      <block wx:if="{{quiz}}">
        <view class="quiz-q">{{quiz.question}}</view>
        <view
          wx:for="{{quiz.options}}"
          wx:key="index"
          class="quiz-opt {{quizPicked && index === quiz.answer ? 'correct' : ''}}"
          data-i="{{item.index}}"
          bindtap="pickQuiz"
        >{{item.letter}}. {{item.text}}</view>
        <view class="quiz-res {{quizCorrect ? 'ok-text' : 'warn-text'}}" wx:if="{{quizPicked}}">
          {{quizCorrect ? '✓ 答对了' : '✗ 答错了，正确答案 ' + quiz.answerLetter}}
        </view>
      </block>

      <!-- 问答模式：正面 -->
      <block wx:if="{{!quiz && !showBack}}">
        <view class="front-text">{{front}}</view>
        <view class="btn-primary" bindtap="showAnswer">显示答案</view>
      </block>

      <!-- 问答模式：背面（答案+解析+关联考点） -->
      <block wx:if="{{!quiz && showBack}}">
        <view class="front-text">{{front}}</view>
        <view class="back-text">{{back}}</view>
        <view class="tags-row">
          <text class="tag" wx:for="{{tags}}" wx:key="*this">{{item}}</text>
        </view>
        <view class="source muted" wx:if="{{source}}">📖 来源：{{source}}</view>
      </block>
    </view>

    <!-- 评级（quiz 模式需先作答） -->
    <view class="card" wx:if="{{!quiz || quizPicked}}">
      <view class="rate-label muted">这次还记得吗？</view>
      <view class="rate-row">
        <view class="rate-btn r1" data-r="1" bindtap="rate">忘记</view>
        <view class="rate-btn r2" data-r="2" bindtap="rate">困难</view>
        <view class="rate-btn r3" data-r="3" bindtap="rate">记得</view>
        <view class="rate-btn r4" data-r="4" bindtap="rate">简单</view>
      </view>
      <view class="muted center-text">连续打卡 {{streak}} 天</view>
    </view>
  </block>

</view>
