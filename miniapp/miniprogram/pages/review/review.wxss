/* pages/review/review.wxss */
.page { padding-bottom: 60rpx; }
.center-text { text-align: center; margin: 8rpx 0; }
.progress { text-align: center; margin-top: 20rpx; }

/* 问答/选择题模式切换 */
.mode-line {
  display: flex;
  justify-content: center;
  margin: 16rpx 24rpx 4rpx;
}
.mode-pill {
  background: #EDE4D4;
  color: #6B5B45;
  border-radius: 24rpx;
  padding: 8rpx 30rpx;
  font-size: 24rpx;
  margin: 0 8rpx;
}
.mode-pill.active {
  background: #0E5A4A;
  color: #F5EFE6;
}

.done-title { font-size: 34rpx; font-weight: 600; color: #2F6B3E; padding: 20rpx 0; }

.front-text {
  font-size: 34rpx;
  font-weight: 600;
  color: #4A3F32;
  padding: 12rpx 0 24rpx;
}

.back-text {
  font-size: 28rpx;
  color: #2B2620;
  white-space: pre-wrap;
  background: #F7F2E8;
  border-radius: 10rpx;
  padding: 16rpx;
  margin: 8rpx 0;
}

.tags-row { margin-top: 12rpx; }
.source {
  margin-top: 12rpx;
  border-top: 1rpx dashed #E3D9C8;
  padding-top: 10rpx;
}

/* 选择题 */
.quiz-q { font-size: 32rpx; font-weight: 600; color: #4A3F32; margin-bottom: 16rpx; }
.quiz-opt {
  background: #FFFDF8;
  border: 1rpx solid #E3D9C8;
  border-radius: 10rpx;
  padding: 14rpx 18rpx;
  margin-bottom: 12rpx;
  font-size: 27rpx;
}
.quiz-opt.correct {
  background: #DCE6DE;
  border-color: #0E5A4A;
  color: #0E5A4A;
}
.quiz-res { font-size: 28rpx; font-weight: 600; margin-top: 8rpx; }
.ok-text { color: #0E5A4A; }
.warn-text { color: #A33B2E; }

/* 评级 */
.rate-row { display: flex; justify-content: space-between; margin: 12rpx 0; }
.rate-btn {
  flex: 1;
  text-align: center;
  border-radius: 10rpx;
  padding: 18rpx 0;
  margin: 0 6rpx;
  font-size: 28rpx;
  color: #FFF;
}
.r1 { background: #C0392B; }
.r2 { background: #D68910; }
.r3 { background: #0E5A4A; }
.r4 { background: #1A5276; }
.rate-label { text-align: center; }
